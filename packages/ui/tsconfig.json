{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    /* 🚨 OVERRIDES */
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "isolatedModules": false,

    /* Output */
    "jsx": "react-jsx",
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}