# Agent environment lives at: apps/agent/.env.example

# Database connections
DATABASE_URL=postgresql://user:password@db:5432/mydb
CLICKHOUSE_URL=http://clickhouse:8123

# App URLs
# Server-side (Docker internal)
APP_URL=http://web:3000
API_BASE_URL=http://web:3000
# Client-side (browser - must be external URL)
BETTER_AUTH_URL=https://example.com
NEXT_PUBLIC_API_URL=https://example.com

# Redis
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379

# Cron/auth
INTERNAL_CRON_SECRET=changeme
BETTER_AUTH_SECRET=changeme

# Postgres
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=mydb

# ClickHouse
CLICKHOUSE_DB=analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=password

# OAuth / API keys
GOOGLE_CLIENT_ID=changeme
GOOGLE_CLIENT_SECRET=changeme
OPENAI_API_KEY=changeme

# Other
VPS_AUTH_PROFILE_PATH=/storage
DEBUG_ENABLED=false