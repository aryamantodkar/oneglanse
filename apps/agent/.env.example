# Environment Configuration Template
# Copy this file to .env.local and .env.vps and fill in your values

# Node environment (development for local, production for VPS)
NODE_ENV=development

# VPS Configuration (for local machine)
VPS_IP=82.208.23.245
VPS_USER=onescope
VPS_API_URL=http://82.208.23.245:3333

# API Authentication Token (generate with: openssl rand -hex 32)
# MUST be the same on both local and VPS
API_AUTH_TOKEN=your-generated-token-here

# Storage path for auth sessions
AUTH_PROFILE_PATH=./storage

# Redis configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Optional: Chisel tunnel authentication (format: username:password)
CHISEL_AUTH=

# Legacy VPS configuration (for SSH-based upload - deprecated)
VPS_HOST=82.208.23.245
VPS_PATH=/home/onescope/onescope-agent/storage
